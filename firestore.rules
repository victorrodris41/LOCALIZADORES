// ATENÇÃO: estas regras são um ponto de partida.
// Para produção, habilite Firebase Authentication e use custom claims para admin.
// Não publique estas regras sem revisar sua política de acesso.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventario/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
